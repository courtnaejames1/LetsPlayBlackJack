<turbo-frame id="dealers_hands">
    <% if games_over %>
    <strong> <%= status %> </strong>
      <p class=" flex justify-center">Dealer <%= dealers_score %></p>
  <%else %>
    <p>&nbsp;</p>
  <% end %>
  <div class=" flex flex-row justify-center space x-2">
    <% dealers_hands.each_with_index do |dealer_card, index| %>
    <% if index == 1 && !games_over %>
      <%= image_tag "BACK.png", alt:"dealers hidden card", width:100, height:100 %>
        <%else %>
        <%= image_tag "#{dealer_card}.png", alt:"dealers shown card", width: 100, height:100 %>
      <% end %>
    <% end %>
  </div>
  <div class="p-5 "></div>
  <% if games_over %>
    <p class="flex justify-center">User: <%= users_score %></p>
  <% else %>
    <p>&nbsp;</p>
  <% end %>

</turbo-frame>