<% content_for :title, "Games" %>

<h1>Games</h1>
<% if user_signed_in? %>
  <div id="games">
    <% @games.where(user_id: current_user).each do |game| %>
      <%= render game %>
      <p>
        <%= link_to "Show this game", game %>
      </p>
    <% end %>
  </div>
<%else %>
  <%= link_to "Sign in", new_user_session_path %>
<% end %>


