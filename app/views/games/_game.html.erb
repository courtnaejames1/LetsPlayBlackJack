<div id="<%= dom_id game %>">
  <div>
    <strong>Name:</strong>
    <%= game.name %>
  </div>

  <div>
    <strong>Starting bet:</strong>
    <%= game.starting_bet %>
  </div>

  <div>
    <strong> Win or Lose? </strong>
    <%= game.win_or_lose? ? 'Yes' : 'No'%>
  </div>

</div>


