<turbo-frame id="new_game">
  <div id="<%= dom_id game %>">
    <div>
      <strong>Name:</strong>
      <%= game.name %>
    </div>

    <div>
      <strong>Starting bet:</strong>
      <%= game.starting_bet %>
    </div>

    <div>
      <strong> Status? </strong>
      <%= game.status %>
    </div>

</div>
</turbo-frame>
